generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  FINISHED
  CANCELLED
}

enum ModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum AdditionMethod {
  MANUAL
  AUTOMATIC
}

enum SourceType {
  WEBSITE
  TELEGRAM
  RSS
  API
  SOCIAL
  MANUAL
}

enum CollectionMethod {
  HTML
  RSS
  API
  TELEGRAM
  MANUAL
}

enum ProcessingStatus {
  NEW
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
}

enum CollectorRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ModerationAction {
  CREATED
  EDITED
  PUBLISHED
  REJECTED
  MERGED
  CANCELLED
}

enum DuplicateStatus {
  PENDING
  AUTO_MATCHED
  CONFIRMED
  DISMISSED
}

enum CollectionKind {
  AUTOMATIC
  EDITORIAL
}

enum ShareChannel {
  NATIVE
  TELEGRAM
  VK
  COPY
}

enum EngagementAction {
  VIEW
  TICKET
}

model City {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  region      String?
  countryCode String       @default("BY")
  timezone    String       @default("Europe/Minsk")
  latitude    Decimal?     @db.Decimal(9, 6)
  longitude   Decimal?     @db.Decimal(9, 6)
  active      Boolean      @default(true)
  venues      Venue[]
  events      Event[]
  sources     Source[]
  collections Collection[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Venue {
  id         String   @id @default(cuid())
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])
  slug       String
  name       String
  address    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  websiteUrl String?
  events     Event[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, name])
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  icon      String?
  color     String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  events    Event[]
}

model Organizer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  websiteUrl  String?
  phone       String?
  email       String?
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id                       String                @id @default(cuid())
  slug                     String                @unique
  title                    String
  shortDescription         String?
  description              String?
  imageUrl                 String?
  cityId                   String
  city                     City                  @relation(fields: [cityId], references: [id])
  venueId                  String?
  venue                    Venue?                @relation(fields: [venueId], references: [id])
  address                  String?
  startsAt                 DateTime
  timeTbd                  Boolean               @default(false)
  endsAt                   DateTime?
  categoryId               String
  category                 Category              @relation(fields: [categoryId], references: [id])
  organizerId              String?
  organizer                Organizer?            @relation(fields: [organizerId], references: [id])
  priceMin                 Decimal?              @db.Decimal(10, 2)
  priceMax                 Decimal?              @db.Decimal(10, 2)
  currency                 String                @default("BYN")
  isFree                   Boolean               @default(false)
  ageRestriction           String?
  ticketUrl                String?
  canonicalSourceUrl       String?
  status                   EventStatus           @default(DRAFT)
  confidence               Decimal?              @db.Decimal(4, 3)
  publishConfidence        Decimal?              @db.Decimal(4, 3)
  additionMethod           AdditionMethod        @default(MANUAL)
  moderationStatus         ModerationStatus      @default(NOT_REQUIRED)
  isFeatured               Boolean               @default(false)
  viewCount                Int                   @default(0)
  sources                  EventSource[]
  occurrences              EventOccurrence[]
  moderationLogs           ModerationLog[]
  duplicateCandidates      DuplicateCandidate[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  publishedAt              DateTime?
  publicationEvaluatedAt   DateTime?
  publicationPolicyVersion String?
  collectionItems          CollectionEvent[]
  collectionExclusions     CollectionExclusion[]
  shareMetrics             EventShareMetric[]
  engagementMetrics        EventEngagementMetric[]

  @@index([cityId, status, startsAt])
  @@index([categoryId, startsAt])
  @@index([isFree, startsAt])
}

model EventShareMetric {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel   ShareChannel
  day       DateTime     @db.Date
  count     Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([eventId, channel, day])
  @@index([day])
  @@index([eventId, day])
}

model EventEngagementMetric {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action    EngagementAction
  day       DateTime         @db.Date
  count     Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, action, day])
  @@index([day])
  @@index([eventId, day])
}

model EventOccurrence {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime?
  price      Decimal?  @db.Decimal(10, 2)
  ticketUrl  String?
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([eventId, startsAt])
  @@index([startsAt])
}

model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        String    @default("EDITOR")
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminLoginThrottle {
  clientHash      String    @id
  failedCount     Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model Source {
  id               String           @id @default(cuid())
  name             String
  type             SourceType
  url              String
  cityId           String?
  city             City?            @relation(fields: [cityId], references: [id])
  active           Boolean          @default(true)
  trustScore       Decimal          @default(0.5) @db.Decimal(4, 3)
  collectionMethod CollectionMethod
  config           Json?
  lastCheckedAt    DateTime?
  rawEvents        RawEvent[]
  eventSources     EventSource[]
  collectorRuns    CollectorRun[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([type, url])
  @@index([active, cityId])
}

model RawEvent {
  id                   String               @id @default(cuid())
  sourceId             String
  source               Source               @relation(fields: [sourceId], references: [id])
  externalId           String?
  url                  String
  rawText              String
  rawHtml              String?
  imageUrl             String?
  publishedAt          DateTime?
  collectedAt          DateTime             @default(now())
  processingStatus     ProcessingStatus     @default(NEW)
  parsedData           Json?
  processingError      String?
  parserVersion        String?
  parserModel          String?
  aiResponseId         String?
  processingAttempts   Int                  @default(0)
  processedAt          DateTime?
  lifecycleProcessedAt DateTime?
  inputTokens          Int?
  outputTokens         Int?
  eventSources         EventSource[]
  moderationLogs       ModerationLog[]
  duplicateCandidates  DuplicateCandidate[]

  @@unique([sourceId, externalId])
  @@unique([sourceId, url])
  @@index([processingStatus, collectedAt])
  @@index([lifecycleProcessedAt])
}

model EventSource {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id])
  rawEventId String?
  rawEvent   RawEvent? @relation(fields: [rawEventId], references: [id])
  sourceUrl  String
  isPrimary  Boolean   @default(false)
  observedAt DateTime  @default(now())

  @@unique([eventId, sourceId, sourceUrl])
  @@index([rawEventId])
}

model DuplicateCandidate {
  id         String          @id @default(cuid())
  rawEventId String
  rawEvent   RawEvent        @relation(fields: [rawEventId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  score      Decimal         @db.Decimal(4, 3)
  breakdown  Json
  status     DuplicateStatus @default(PENDING)
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([rawEventId, eventId])
  @@index([status, score])
}

model CollectorRun {
  id           String             @id @default(cuid())
  sourceId     String
  source       Source             @relation(fields: [sourceId], references: [id])
  status       CollectorRunStatus @default(RUNNING)
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  foundCount   Int                @default(0)
  createdCount Int                @default(0)
  skippedCount Int                @default(0)
  errorCount   Int                @default(0)
  errorMessage String?
  metadata     Json?

  @@index([sourceId, startedAt])
}

model SystemError {
  id              String    @id @default(cuid())
  component       String
  operation       String?
  severity        String    @default("ERROR")
  message         String
  stack           String?
  context         Json?
  fingerprint     String?
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([resolvedAt, lastSeenAt])
  @@index([fingerprint])
}

model ModerationLog {
  id         String           @id @default(cuid())
  eventId    String?
  event      Event?           @relation(fields: [eventId], references: [id])
  rawEventId String?
  rawEvent   RawEvent?        @relation(fields: [rawEventId], references: [id])
  actorId    String?
  action     ModerationAction
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime         @default(now())

  @@index([eventId, createdAt])
  @@index([rawEventId, createdAt])
}

model Collection {
  id          String                @id @default(cuid())
  cityId      String
  city        City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  kind        CollectionKind        @default(AUTOMATIC)
  rule        Json
  active      Boolean               @default(true)
  generatedAt DateTime?
  items       CollectionEvent[]
  exclusions  CollectionExclusion[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([cityId, slug])
  @@index([active, generatedAt])
}

model CollectionEvent {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position     Int
  pinned       Boolean    @default(false)
  addedAt      DateTime   @default(now())

  @@id([collectionId, eventId])
  @@index([collectionId, position])
}

model CollectionExclusion {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, eventId])
}

model AutomationRun {
  id           String    @id
  status       String    @default("RUNNING")
  trigger      String    @default("manual")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  steps        Json?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}

model AutomationLock {
  key       String   @id
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
